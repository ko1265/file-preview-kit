{
  "name": "@ko1265/file-preview-kit-shared",
  "version": "1.0.0",
  "description": "Shared preview contracts for file-preview-kit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ko1265/file-preview-kit.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/ko1265/file-preview-kit/issues"
  },
  "homepage": "https://github.com/ko1265/file-preview-kit/tree/main/packages/shared",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
