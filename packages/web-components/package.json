{
  "name": "@file-preview-kit/web-components",
  "version": "0.1.0",
  "description": "Standalone Web Components file preview element for remote URLs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@file-preview-kit/core": "workspace:*",
    "@file-preview-kit/shared": "workspace:*"
  },
  "keywords": ["file-preview", "web-components", "custom-elements", "frontend"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; Remove-Item -Force tsconfig.tsbuildinfo -ErrorAction SilentlyContinue",
    "lint": "tsc --noEmit"
  }
}
