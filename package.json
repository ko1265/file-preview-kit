{
  "name": "file-preview-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Pure frontend TypeScript monorepo for remote URL file preview via Web Components.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm test",
    "clean": "pnpm -r clean",
    "dev": "pnpm --filter @file-preview-kit/demo dev",
    "lint": "pnpm -r lint",
    "pack:check": "pnpm -r --filter ./packages/* exec pnpm pack",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^16.5.3",
    "jszip": "^3.10.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  }
}
